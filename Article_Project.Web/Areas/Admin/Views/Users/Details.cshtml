@model Article_Project.Dtoes.Dto.AdminArea.Users.UserDetailDto
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService _authorizeService

@{
    ViewData["Title"] = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Details</h1>

<div>
    <h4>UserDetailDto</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UserName)
        </dt>
        <dd class="col-sm-10">
            <a class="btn btn-outline-light border-info" asp-area="" asp-controller="User" asp-action="Profile" asp-route-UserName="@Model.UserName">
                <i class="fa fa-user text-info"></i>
            </a>
            @Html.DisplayFor(model => model.UserName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.VerifyEmail)
        </dt>
        <dd class="col-sm-10">
            @if (_authorizeService.AuthorizeAsync(User, "AdminUsers").Result.Succeeded)
            {
            <a class="btn btn-outline-light border-warning" asp-action="ChangeConfirmEmail" asp-route-UserId="@Model.Id">
                <i class="fa fa-undo text-warning"></i>
            </a>
            }
            @Html.DisplayFor(model => model.VerifyEmail)
        </dd>


        @if (_authorizeService.AuthorizeAsync(User, "AdminUsers").Result.Succeeded)
        {
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Roles)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Roles)
            </dd>
        }

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsLocked)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsLocked)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TwoFactor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TwoFactor)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CountPosts)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CountPosts)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CountComment)
        </dt>
        <dd class="col-sm-10">
            @{
                if (Model.CountComment > 0)
                {
                    <a asp-area="Admin" asp-controller="Comments" asp-action="ListComments" asp-route-UserId="@Model.Id" asp-route-Search="">
                        @Html.DisplayFor(model => model.CountComment)
                    </a>
                }
                else
                {
                    @Html.DisplayFor(model => model.CountComment)
                }
            }

        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ImageProName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ImageProName)
        </dd>
    </dl>
</div>
<div>
    @if (_authorizeService.AuthorizeAsync(User, "AdminUsers").Result.Succeeded)
    {
        @Html.ActionLink("Add Role", "AddUserRole", "Users", new { Id = Model.Id, area = "Admin" }) @:|
        @Html.ActionLink("Roles", "RolesList", "Users", new { UserName = Model.UserName, area = "Admin" })@:|
    }

    <a asp-action="Index">Back to List</a>

</div>
