@model IEnumerable<Article_Project.Dtoes.Dto.AdminArea.Role.UsersInRoleDto>

@using Microsoft.AspNetCore.Identity.EntityFrameworkCore
@inject UserManager<User> _userManager

@{
    ViewData["Title"] = "UsersInRole";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string roleName = ViewData["RoleName"].ToString();
}

<h3>لیست کاربران با نقش @roleName</h3>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Roles)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Roles)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @if (roleName == "Admin")
                    {
                        if (_userManager.GetUsersInRoleAsync("Admin").Result.Count != 1)
                        {
                            @Html.ActionLink($"Delete In {roleName} Role ", "DeleteUserRole", "Role", new { Name = roleName, UserId = item.Id, area = "Admin" });
                        }
                    }
                    else
                    {
                        @Html.ActionLink($"Delete In {roleName} Role ", "DeleteUserRole", "Role", new { Name = roleName, UserId = item.Id, area = "Admin" });
                    }
                    <a class="btn btn-outline-light border-warning" asp-controller="Users" asp-action="Details" asp-route-UserId="@item.Id">
                        <i class="fa fa-tv text-warning"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
