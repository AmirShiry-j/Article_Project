@model Article_Project.Dtoes.Dto.Account.ResetPasswordDto

@{
    ViewData["Title"] = "بازیابی رمز عبور";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="main-container-div d-flex justify-content-center align-items-start">
    <div class="inner-container-div col-12 col-md-10 col-lg-9">
        <div class="login-div">
            <div class="title-login-div">
                <img class="login-img" src="~/images/Userimg.png" alt="ورود به حساب کاربری" />
                <h1>بازیابی رمز عبور</h1>
            </div>
            <hr class="bg-warning" />
            <div class="form-div">
                <form asp-action="ResetPassword">

                    <div class="row">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 my-2">
                            <label for="Password" class="mt-2">رمز عبور جدید</label>
                            <input name="Password" autocomplete="off" type="password" class="form-control"
                                   asp-for="Password" />
                            <span class="text-danger"
                                  asp-validation-for="Password"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 my-2">
                            <label for="ConfirmPassword" class="mt-2">تکرار رمز عبور جدید</label>
                            <input name="ConfirmPassword" autocomplete="off" type="password" class="form-control"
                                   asp-for="ConfirmPassword" />
                            <span class="text-danger"
                                  asp-validation-for="ConfirmPassword"></span>

                            <input asp-for="Token" type="hidden" class="form-control" />
                            <input asp-for="UserId" type="hidden" class="form-control" />

                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 text-center">
                            <input class="btn btn-info border-0 rounded-pill login-btn-inuput" type="submit" value="بازیابی رمز عبور" />
                            <a class="btn border rounded-pill signup-a" asp-action="Register">ثبت نام</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Meta{

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="follow, index">
    <meta name="description" content="بازیابی رمز عبور">
    <meta name="keyword" content="بازیابی رمز عبور,مقاله , وبلاگ , مقاله نویسی , وبلاگ نویسی , وبلاگر ">
    <meta name="author" content="وبلاگر">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

}

@section Css{


    <link rel="stylesheet" href="~/css/Pages/Login.css" type="text/css" />

}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
