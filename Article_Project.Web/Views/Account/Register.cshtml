@model Article_Project.Dtoes.Dto.Account.RegisterDto

@{
    ViewData["Title"] = "ساخت حساب";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-container-div d-flex justify-content-center align-items-start">
    <div class="inner-container-div col-12 col-md-10 col-lg-9">
        <div class="signup-div">
            <div class="title-signup-div">
                <img class="signup-img" src="~/images/Userimg.png" alt="ایجاد حساب کاربری" />
                <h1>ایجاد حساب کاربری</h1>
            </div>
            <hr class="bg-warning" />
            <div class="form-div">
                <form asp-action="Register" method="post">
                    <div class="row">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 my-3">
                            <label for="UserName">نام کاربری</label>
                            <input name="UserName" autocomplete="off" type="text" class="form-control"
                                   asp-for="UserName" />
                            <span class="text-danger"
                                  asp-validation-for="UserName"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 my-3">
                            <label for="Email">ایمیل</label>
                            <input name="Email" autocomplete="off" type="text" class="form-control"
                                   asp-for="Email" />
                            <span class="text-danger"
                                  asp-validation-for="Email"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 my-3">
                            <label for="NameShow">نام نمایشی</label>
                            <input name="NameShow" autocomplete="off" type="text" class="form-control"
                                   asp-for="NameShow" />
                            <span class="text-danger"
                                  asp-validation-for="NameShow"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 my-3">
                            <label for="Password">رمز عبور</label>
                            <input name="Password" autocomplete="off" type="password" class="form-control"
                                   asp-for="Password" />
                            <span class="text-danger"
                                  asp-validation-for="Password"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 my-3">
                            <label for="ConfirmPassword">تکرار رمز عبور</label>
                            <input name="ConfirmPassword" autocomplete="off" type="password" class="form-control"
                                   asp-for="ConfirmPassword" />
                            <span class="text-danger"
                                  asp-validation-for="ConfirmPassword"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 text-center">
                            <input class="btn btn-info border-0 rounded-pill signup-btn-inuput" type="submit" value="ثبت نام" />
                            <a class="btn border rounded-pill login-a" asp-action="Login">ورود</a>
                        </div>
                    </div>


                </form>
            </div>
        </div>
    </div>
</div>
@section Meta {
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ساخت حساب کاربری در سایت وبلاگر">
    <meta name="keyword" content="signin,حساب کاربری,ساخت حساب,مقاله , وبلاگ , مقاله نویسی , وبلاگ نویسی , وبلاگر ">
    <meta name="author" content="وبلاگر">
    <meta name="robots" content="follow, index">

}
@section Css {



    <link rel="stylesheet" href="~/css/Pages/Signup.css" type="text/css" />

}

@section Scripts {

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}
