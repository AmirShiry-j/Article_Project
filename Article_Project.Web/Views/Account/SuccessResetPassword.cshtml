
@{
    ViewData["Title"] = "موفقیت در بازیابی رمز عبور";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<main class="d-flex justify-content-center">
    <div class="error-div col-11 col-sm-10 col-md-8 col-lg-7">
        <div class="text-error-div alert-success p-5 text-center">
            بازیابی رمز عبور شما با موفقیت انجام شد
        </div>
        <h6 class="help-h6 text-center">
            برای رفتن به صفحه ورود به حساب سایت وبلاگر بر روی دکمه زیر کلیک کنید
        </h6>
        <a asp-controller="Home" asp-action="Index" class="main-page-a btn btn-info">
            ورود به حساب سایت وبلاگر
        </a>
    </div>
</main>

@section Meta{
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="عملیات بازیابی رمز عبور با موفقیت انجام شد">
    <meta name="keyword" content="موفق,بازیابی رمز عبور , مقاله نویسی , وبلاگ نویسی , وبلاگر ,ارور,پیدا نکردن">
    <meta name="author" content="وبلاگر">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="nofollow, noindex">
}
@section Css{

    <link rel="stylesheet" href="~/css/Pages/Error.css" type="text/css" />

}

