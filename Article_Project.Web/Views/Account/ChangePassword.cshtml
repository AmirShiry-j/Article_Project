@model Article_Project.Dtoes.Dto.Account.ChangePasswordDto

@{
    ViewData["Title"] = "تغییر رمز عبور";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="main-container-div d-flex justify-content-center align-items-start">
    <div class="inner-container-div col-12 col-md-10 col-lg-9">
        <div class="login-div">
            <div class="title-login-div">
                <img class="login-img" src="~/images/Userimg.png" alt="ورود به حساب کاربری" />
                <h1>تغییر رمز عبور</h1>
            </div>
            <hr class="bg-warning" />
            <div class="form-div">
                <form asp-action="ChangePassword">
                    <div class="row">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 mt-4">
                            <label asp-for="NowPassword">زمز عبور فعلی</label>
                            <input asp-for="NowPassword" autocomplete="off" type="password" class="form-control" />
                            <span class="text-danger"
                                  asp-validation-for="NowPassword"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 my-2">
                            <label asp-for="NewPassword" class="mt-2">رمز عبور جدید</label>
                            <input asp-for="NewPassword" autocomplete="off" type="password" class="form-control" />
                            <span class="text-danger"
                                  asp-validation-for="NewPassword"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 my-2">
                            <label asp-for="ConfirmPassword" class="mt-2">تکرار رمز عبور جدید</label>
                            <input asp-for="ConfirmPassword" autocomplete="off" type="password" class="form-control" />
                            <span class="text-danger"
                                  asp-validation-for="ConfirmPassword"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 text-center">
                            <input class="btn btn-info border-0 rounded-pill login-btn-inuput" type="submit" value="تغییر پسورد" />
                            <a class="btn border rounded-pill signup-a" asp-action="Edit">بازگشت</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Meta{

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="follow, index">
    <meta name="description" content="تغییر رمز عبور حساب شما">
    <meta name="keyword" content="تغییر رمز عبور, وبلاگ نویسی , وبلاگر ">
    <meta name="author" content="وبلاگر">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

}

@section Css{

    <link rel="stylesheet" href="~/css/Pages/Login.css" type="text/css" />

}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
