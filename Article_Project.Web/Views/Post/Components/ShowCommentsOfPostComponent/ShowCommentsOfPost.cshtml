@model Tuple<User, IEnumerable<Comment>>

@inject IUnitOfWork _unitOfWork
@{
    Layout = null;

    var userLogined = Model.Item1;
    var comments = Model.Item2;

    var postId = ViewBag.PostId;
    var authorId = ViewBag.AuthorId;

    ServicePost servicePost = new ServicePost(_unitOfWork);
}

<div class="comments-div">

    @if (userLogined == null)
    {
        <div class="alert alert-info">
            برای ثبت دیدگاه خود لازم است به سایت <a asp-controller="Account" asp-action="Login" class="text-dark  text-decoration-none">وارد</a> شوید یا در صورت نداشتن حساب در سایت <a asp-controller="Account" asp-action="Register" class="text-dark text-decoration-none">ثبت نام</a> کنید.
        </div>

    }
    else
    {
        <div class="create-comment-div">
            <div class="d-flex add-comment-div">
                <div>
                    @if (userLogined.ImageProfileName != null)
                    {
                        <img class="user-img rounded-circle" src="~/images/ImgProfile/@userLogined.ImageProfileName" alt="@userLogined.NameShow" />

                    }
                    else
                    {
                        <img class="user-img rounded-circle" src="~/images/Userimg.png" />

                    }
                </div>
                <div class="title-comment-div d-flex">
                    <span>دیدگاه خود را درباره این پست بنویسید</span>
                </div>
            </div>
            <div class="write-comment-div d-none">

                <input class="post-id-input d-none" value="@postId" />
                <input class="author-id-input d-none" value="@authorId" />

                <input class="replay-comment-input d-none" value="0" />

                <textarea class="text-comment-input form-control" rows="4" placeholder="دیدگاه خودتون رو بنویسید"></textarea>
                <div class="d-flex justify-content-end">
                    <button type="button" class="send-comment-btn btn btn-success disabled">ارسال دیدگاه</button>
                </div>
            </div>
        </div>
    }

    @if (comments != null)
    {
        List<Comment> MainComments = comments.Where(c => c.ReplyComment == null).ToList();
        List<Comment> allReplyComments = comments.Where(c => c.ReplyComment != null).ToList();

        foreach (var mainComment in MainComments)
        {
            User senderComment = _unitOfWork.UserRepository.GetByIdAsync(mainComment.UserId).Result;

            <div class="comment-div">
                <div class="comment-title-div">
                    <div>
                        <a asp-controller="User" asp-action="Profile" asp-route-UserName="@senderComment.UserName">
                            @if (senderComment.ImageProfileName != null)
                            {
                                <img class="user-img rounded-circle" src="~/images/ImgProfile/@senderComment.ImageProfileName" alt="@senderComment.NameShow" />

                            }
                            else
                            {
                                <img class="user-img rounded-circle" src="~/images/Userimg.png" />
                            }
                        </a>
                    </div>
                    <div class="p-2">
                        <a asp-controller="User" asp-action="Profile" asp-route-UserName="@senderComment.UserName" class="text-dark text-decoration-none">
                            <h5 class="nameshow-h5">@senderComment.NameShow</h5>
                        </a>
                        <h6 class="time-h6">@servicePost.GetCurrentTime(mainComment.Time)</h6>

                    </div>
                </div>
                <div class="comment-body-div">
                    <p class="text-comment-p text-break">
                        @mainComment.Text
                    </p>
                </div>
                <hr class="m-0" />
                <div class="comment-footer-div">

                    <button comment-id="@mainComment.CommentId" class="reply-btn btn"><i class="fa fa-comment-o"></i>&nbsp;&nbsp;پاسخ دهید&nbsp;&nbsp;&nbsp;</button>

                </div>

                @{
                    var replays = allReplyComments.Where(p => p.ReplyComment == mainComment.CommentId);

                    @if (replays.Any())
                    {
                        foreach (var replay in replays)
                        {
                            var senderReply = _unitOfWork.UserRepository.GetByIdAsync(replay.UserId).Result;

                            <hr class="m-0" />
                            <div class="replys-div">


                                <div class="reply-div">
                                    <div class="comment-title-div">
                                        <div>
                                            <a asp-controller="User" asp-action="Profile" asp-route-UserName="@senderReply.UserName">
                                                @if (senderReply.ImageProfileName != null)
                                                {
                                                    <img class="user-img rounded-circle" src="~/images/ImgProfile/@senderReply.ImageProfileName" alt="@senderReply.NameShow" />

                                                }
                                                else
                                                {
                                                    <img class="user-img rounded-circle" src="~/images/Userimg.png" />

                                                }
                                            </a>
                                        </div>
                                        <div class="p-2">
                                            <a asp-controller="User" asp-action="Profile" asp-route-UserName="@senderReply.UserName" class="text-dark text-decoration-none">
                                                <h5 class="nameshow-h5">@senderReply.NameShow</h5>
                                            </a>
                                            <h6 class="time-h6">@servicePost.GetCurrentTime(replay.Time)</h6>

                                        </div>
                                    </div>
                                    <div class="comment-body-div">
                                        <p class="text-comment-p text-break">
                                            @replay.Text
                                        </p>
                                    </div>
                                    <hr class="m-0" />
                                </div>

                            </div>
                        }
                    }
                }
            </div>
        }
    }
</div>